@page "/heatmap"

<PageTitle>Heatmap</PageTitle>

<MudText Typo="Typo.h6" HtmlTag="h1" Class="mt-2 mb-2">Heatmap</MudText>
<div class="grid">
    <SampleCard Title="Accesses by the day and the hour">
        <MusselHeatmapView Height="280" Items="Accesses" Row="static x => x.Day" Column="static x => x.Hour" Value="static x => x.Count" ValueFormat="N0" />
    </SampleCard>
    <SampleCard Title="Daily activity as a calendar">
        <MusselHeatmapView Height="240" Items="Activities" LayoutMode="ChartHeatmapLayoutMode.Calendar" Date="static x => x.Date" Value="static x => x.Value" ColorScale="BlueScale" ValueFormat="N0" />
    </SampleCard>
    <SampleCard Title="Scale on the right and empty cells">
        <MusselHeatmapView Height="220" Items="Loads" Row="static x => x.Server" Column="static x => x.Time" Value="static x => x.Load" LegendPosition="ChartLegendPosition.Right" ColorScale="ChartPalettes.OrangesLight" CellGap="2" ValueFormat="{0:N0}%" Minimum="0" Maximum="100" />
    </SampleCard>
</div>
